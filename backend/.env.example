# SevaConnect Backend Environment Configuration Example
# Copy this file to .env and fill in your credentials

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sevaconnect

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
